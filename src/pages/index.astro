---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} image="/frog-pip.svg" />
	</head>
	<body>
		<Header />
		<main class="home">
			<section class="hero">
				<div class="hero-copy">
					<p class="brand-mark">Pip's Pond</p>
					<h1>hi. i am a very small frog.</h1>
					<p class="lede">
						Someone 3D-printed me and left me out in the world. If you found me — or just found
						this page — welcome to my tiny journal.
					</p>
					<a class="cta" href="/blog">read the journal</a>
				</div>
				<div class="hero-art" aria-hidden="true">
					<img class="frog" src="/frog-pip.svg" alt="" width="320" height="280" />
					<span class="pad pad-a"></span>
					<span class="pad pad-b"></span>
				</div>
			</section>
		</main>
		<Footer />
	</body>
</html>

<style>
	.home {
		padding-top: 1.5rem;
		padding-bottom: 2rem;
	}
	.hero {
		min-height: calc(100vh - 8rem);
		display: grid;
		align-items: center;
		gap: 2rem;
		animation: rise 0.8s ease-out both;
	}
	.brand-mark {
		font-family: "Fredoka", sans-serif;
		font-size: clamp(2.6rem, 8vw, 4.2rem);
		font-weight: 600;
		color: var(--accent-dark);
		margin: 0 0 0.35rem;
		letter-spacing: -0.02em;
		line-height: 1;
	}
	.hero h1 {
		font-size: clamp(1.35rem, 3.5vw, 1.85rem);
		font-weight: 500;
		color: rgb(var(--gray));
		margin: 0 0 0.85rem;
	}
	.lede {
		margin: 0 0 1.5rem;
		max-width: 28ch;
		color: rgb(var(--gray-dark));
	}
	.cta {
		display: inline-block;
		background: var(--accent);
		color: #f7fbf4;
		text-decoration: none;
		padding: 0.7rem 1.25rem;
		border-radius: 999px;
		font-family: "Fredoka", sans-serif;
		font-weight: 500;
		transition: transform 0.2s ease, background 0.2s ease;
	}
	.cta:hover {
		background: var(--accent-dark);
		color: #f7fbf4;
		transform: translateY(-2px);
	}
	.hero-art {
		position: relative;
		display: grid;
		place-items: center;
		min-height: 240px;
	}
	.frog {
		width: min(320px, 70vw);
		height: auto;
		position: relative;
		z-index: 1;
		animation: hop 3.6s ease-in-out infinite;
		filter: drop-shadow(0 18px 24px rgba(47, 107, 79, 0.18));
	}
	.pad {
		position: absolute;
		border-radius: 50%;
		background: rgba(95, 168, 106, 0.35);
		z-index: 0;
	}
	.pad-a {
		width: 160px;
		height: 48px;
		bottom: 12%;
		left: 12%;
		animation: drift 5s ease-in-out infinite;
	}
	.pad-b {
		width: 110px;
		height: 34px;
		bottom: 22%;
		right: 14%;
		background: rgba(143, 203, 110, 0.3);
		animation: drift 6.5s ease-in-out infinite reverse;
	}
	@keyframes hop {
		0%,
		100% {
			transform: translateY(0) rotate(-1deg);
		}
		50% {
			transform: translateY(-10px) rotate(1.5deg);
		}
	}
	@keyframes drift {
		0%,
		100% {
			transform: translateX(0);
		}
		50% {
			transform: translateX(12px);
		}
	}
	@keyframes rise {
		from {
			opacity: 0;
			transform: translateY(12px);
		}
		to {
			opacity: 1;
			transform: translateY(0);
		}
	}
	@media (min-width: 780px) {
		.hero {
			grid-template-columns: 1.1fr 0.9fr;
			gap: 1rem;
		}
		.lede {
			max-width: 34ch;
		}
	}
</style>
