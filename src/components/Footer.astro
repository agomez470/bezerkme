---
const today = new Date();
---

<footer>
	<p>bezerk likes happy little hiding spots.</p>
	<p class="copy">&copy; {today.getFullYear()} bezerk.me</p>
</footer>
<style>
	footer {
		padding: 2em 1em 3em;
		border-top: 2px solid var(--border);
		background: linear-gradient(0deg, rgba(125, 223, 100, 0.15) 0%, transparent 100%);
		color: var(--text-muted);
		text-align: center;
		font-size: 13px;
	}

	footer p {
		margin: 0.35em 0;
	}

	.copy {
		font-size: 12px;
	}
</style>
