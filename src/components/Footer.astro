---
const today = new Date();
---

<footer>
	<p>© {today.getFullYear()} Pip · a tiny frog somewhere nearby</p>
	<p class="note">If you found a frog, you found this place on purpose.</p>
</footer>
<style>
	footer {
		padding: 2.5em 1em 4em;
		color: rgb(var(--gray));
		text-align: center;
		font-size: 0.95rem;
	}
	footer p {
		margin: 0.35em 0;
	}
	.note {
		font-style: italic;
		opacity: 0.85;
	}
</style>
