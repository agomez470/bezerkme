---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import StlViewer from '../components/StlViewer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog'))
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
	.slice(0, 2);
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
		<style>
			.hero {
				display: grid;
				gap: 1.5em;
				margin-bottom: 2em;
			}

			@media (min-width: 640px) {
				.hero {
					grid-template-columns: 1fr 1fr;
					align-items: start;
				}
			}

			.tagline {
				font-size: 1.1em;
				color: var(--text-muted);
			}

			.recent h2 {
				border-bottom: 2px dotted var(--border);
				padding-bottom: 0.35em;
				margin-bottom: 1em;
			}

			.recent ul {
				list-style: square;
				padding-left: 1.25em;
				margin: 0;
			}

			.recent li {
				margin-bottom: 0.75em;
			}

			.recent .date {
				font-size: 11px;
				color: var(--text-muted);
			}

			.cta {
				margin-top: 1.5em;
				display: flex;
				flex-wrap: wrap;
				gap: 0.75em;
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<section class="hero">
				<div class="hero-copy panel">
					<h1>meet bezerk</h1>
					<p class="tagline">
						A round little African rain frog sculpture with magnets in their feet. Bezerk clings to
						happy spots, comes home with you, and gets painted (or repainted) however you like.
					</p>
					<p>
						The game is simple: hide bezerk somewhere good, let someone find them, then hide them
						again. They do not mind small spaces. They mind boring ones.
					</p>
					<div class="cta">
						<a class="btn" href="/about">about bezerk</a>
						<a class="btn" href="/blog">read the blog</a>
					</div>
				</div>
				<div class="hero-viewer">
					<StlViewer />
				</div>
			</section>

			<section class="recent panel">
				<h2>latest hides</h2>
				{
					posts.length > 0 ? (
						<ul>
							{posts.map((post) => (
								<li>
									<a href={`/blog/${post.id}/`}>
										<strong>{post.data.title}</strong>
									</a>
									<div class="date">
										<FormattedDate date={post.data.pubDate} />
									</div>
								</li>
							))}
						</ul>
					) : (
						<p>Posts coming soon.</p>
					)
				}
			</section>
		</main>
		<Footer />
	</body>
</html>
