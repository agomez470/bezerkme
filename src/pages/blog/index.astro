---
import BaseHead from '../../components/BaseHead.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { SITE_TITLE } from '../../consts';
import { getCollection } from 'astro:content';
import FormattedDate from '../../components/FormattedDate.astro';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead
			title={`Journal · ${SITE_TITLE}`}
			description="Short notes from a tiny frog left out in the world."
		/>
	</head>
	<body>
		<Header />
		<main>
			<h1>journal</h1>
			<p class="intro">Little notes from wherever Pip is sitting today.</p>
			<ul class="post-list">
				{
					posts.map((post) => (
						<li>
							<a href={`/blog/${post.id}/`}>
								<span class="title">{post.data.title}</span>
								<span class="date">
									<FormattedDate date={post.data.pubDate} />
								</span>
								<span class="desc">{post.data.description}</span>
							</a>
						</li>
					))
				}
			</ul>
		</main>
		<Footer />
	</body>
</html>

<style>
	.intro {
		margin-top: -0.25rem;
		margin-bottom: 2rem;
		color: rgb(var(--gray));
	}
	.post-list {
		list-style: none;
		margin: 0;
		padding: 0;
		display: flex;
		flex-direction: column;
		gap: 0.25rem;
	}
	.post-list a {
		display: grid;
		gap: 0.15rem;
		padding: 1rem 0;
		text-decoration: none;
		border-bottom: 1px solid rgba(47, 107, 79, 0.12);
		color: inherit;
		transition: padding-left 0.2s ease;
	}
	.post-list a:hover {
		padding-left: 0.35rem;
	}
	.title {
		font-family: "Fredoka", sans-serif;
		font-size: 1.35rem;
		color: var(--accent-dark);
	}
	.date {
		font-size: 0.9rem;
		color: rgb(var(--gray));
	}
	.desc {
		color: rgb(var(--gray-dark));
		opacity: 0.9;
	}
</style>
